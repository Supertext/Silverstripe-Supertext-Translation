{
    "name": "supertext/silverstripe-supertext-demo",
    "description": "Demo site for Supertext Translation for Silverstripe (deployed to Railway).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-plugin": "~2.1.0",
        "silverstripe/vendor-plugin": "~3.0.0",
        "silverstripe/recipe-cms": "~6.2.0",
        "silverstripe/login-forms": "~6.2.0",
        "silverstripe/htmleditor-tinymce": "~1.1.0",
        "tractorcow/silverstripe-fluent": "^8.2",
        "dnadesign/silverstripe-elemental": "^6.2",
        "supertext/silverstripe-supertext-translation": "@dev"
    },
    "repositories": [
        { "type": "path", "url": "../module", "options": { "symlink": false } }
    ],
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "extra": {
        "resources-dir": "_resources",
        "project-files-installed": [".htaccess", "app/.htaccess", "app/_config/mimevalidator.yml", "app/_config/mysite.yml", "app/src/Page.php", "app/src/PageController.php"],
        "public-files-installed": [".htaccess", "index.php", "web.config"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
