# Railway service variables for the Silverstripe demo (set them in Railway, never commit real values).

# MySQL server; the demo uses (and creates) the database SILVERSTRIPE_DB_NAME on it.
DATABASE_URL=${{MySQL.MYSQL_URL}}
# SILVERSTRIPE_DB_NAME=silverstripe

# Demo accounts, created on every start if no member with that e-mail exists (existing accounts
# are never changed). Log in at /admin with the e-mail address. Passwords must pass Silverstripe's
# password validator (long and varied). Silverstripe 6 has no web installer: without
# DEMO_ADMIN_* there is no administrator.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Member of the "Editors" group: pages in every locale, may translate with Supertext.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext
SUPERTEXT_API_KEY=
# Optional, e.g. a stand-in API: http://127.0.0.1:8765/v1/
# SUPERTEXT_API_URL=

# Set by Railway / optional
# PORT=8080
# RAILWAY_PUBLIC_DOMAIN=
# SS_BASE_URL=https://example.com
